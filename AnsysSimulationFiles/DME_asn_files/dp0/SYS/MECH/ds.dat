secnum,1    ! reset the section ID to default
esel,s,type,,2
keyop,2,7,0         ! Use deformed area for application of load
esel,all

*DIM,_loadvari45,TABLE,2,2,1,Z,TIME, , 12
! Z values
*TAXIS,_loadvari45(1,1),1,-3.,0.
! Time values
*TAXIS,_loadvari45(1,1),2,0.,1.
! Load values
_loadvari45(1,1,1) = 0.
_loadvari45(1,2,1) = 48000.
_loadvari45(2,1,1) = 0.
_loadvari45(2,2,1) = 72000.


esel,all
/gst,on,on
fini
*get,_numnode,node,0,count
*get,_numelem,elem,0,count
